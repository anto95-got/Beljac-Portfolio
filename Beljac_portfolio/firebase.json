{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/veille/refresh",
        "function": {
          "functionId": "refreshVeilleNow",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/veille",
        "function": {
          "functionId": "getVeille",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
